From: Radeon 780M Tahoe downstream
Subject: [PATCH] Initialize command-buffer cleanup state before stream creation

The stream creation failure path calls radv_destroy_cmd_buffer(), which walks
msrtss_transients and finishes descriptor object bases. Initialize those members
before the fallible call, together with the other destructor-owned members.
Keep the allocation failure and its existing error return; this does not fix the
reason a command stream could not be created or any later device loss.

Target: Mesa f5cb8ee032adabef599ae892ec4e42d796b84da9
File license: MIT; retain the upstream copyright and SPDX notice.

diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -1401,13 +1401,6 @@ radv_create_cmd_buffer(struct vk_command_pool *pool, VkCommandBufferLevel level,
       list_inithead(&cmd_buffer->upload.list);
 
       radv_cmd_buffer_init_shader_part_cache(device, cmd_buffer);
-      result =
-         radv_create_cmd_stream(device, ip, cmd_buffer->vk.level == VK_COMMAND_BUFFER_LEVEL_SECONDARY, &cmd_buffer->cs);
-      if (result != VK_SUCCESS) {
-         radv_destroy_cmd_buffer(&cmd_buffer->vk);
-         return vk_error(device, VK_ERROR_OUT_OF_DEVICE_MEMORY);
-      }
-
       for (unsigned i = 0; i < MAX_BIND_POINTS; i++)
          vk_object_base_init(&device->vk, &cmd_buffer->descriptors[i].push_set.set.base, VK_OBJECT_TYPE_DESCRIPTOR_SET);
 
@@ -1415,6 +1408,14 @@ radv_create_cmd_buffer(struct vk_command_pool *pool, VkCommandBufferLevel level,
       cmd_buffer->accel_struct_buffers = _mesa_pointer_set_create(NULL);
       cmd_buffer->ray_history = UTIL_DYNARRAY_INIT;
       list_inithead(&cmd_buffer->msrtss_transients);
+
+      /* All members visited by radv_destroy_cmd_buffer must be initialized first. */
+      result =
+         radv_create_cmd_stream(device, ip, cmd_buffer->vk.level == VK_COMMAND_BUFFER_LEVEL_SECONDARY, &cmd_buffer->cs);
+      if (result != VK_SUCCESS) {
+         radv_destroy_cmd_buffer(&cmd_buffer->vk);
+         return vk_error(device, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      }
    }
 
    if (device->utrace.context) {
