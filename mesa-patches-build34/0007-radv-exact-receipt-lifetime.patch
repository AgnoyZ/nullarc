+/* Source-only paired adapter contract, NOT a wire ABI or capability probe.
+ * No production transport installs it. Configuration is one-shot before any
+ * sequence traffic; destroy still requires caller quiescence. Callbacks must
+ * be bounded and operate on this retained session. They run outside the cache
+ * mutex. submit is serialized and must not recursively submit on this kext.
+ * Completion/prefix replies must include all required device/CPU visibility
+ * and user-fence publication; this cache cannot establish those properties.
+ * retired is the genuine safe GLOBAL prefix, never a client/queue watermark.
+ * wait_prefix(0,0) is an independently defined snapshot, NOT legacy WAITSEQ(0).
+ * ACK -EBUSY certifies retained ownership; all other ACK errors poison the
+ * session because a lost acknowledgement may already have removed a receipt.
+ * Only observation -EINTR/-EAGAIN are retryable; other observation errors
+ * poison the session. No callback may silently replace/reset its session.
+ * submit sets no_dispatch only on a proved rejection with no GPU publication
+ * and no native receipt. Any other error or malformed success is uncertain. */
+#define ACD_EXACT_RECORDS 4096u
+#define ACD_EXACT_ACK_BUDGET 64u
+struct acd_exact_receipt {
+   uint64_t sequence, owner, serial, generation;
+   uint32_t slot, queue;
+};
+struct acd_exact_snapshot {
+   uint64_t owner, retired;
+};
+struct acd_exact_backend {
+   uint64_t owner;
+   void *ctx;
+   int (*submit)(void *ctx, const void *packet, size_t size,
+                 struct acd_exact_receipt *out, bool *no_dispatch);
+   int (*wait)(void *ctx, const struct acd_exact_receipt *receipt, uint64_t rel_ns,
+               bool *busy, struct acd_exact_snapshot *out);
+   int (*ack)(void *ctx, const struct acd_exact_receipt *receipt);
+   int (*wait_prefix)(void *ctx, uint64_t target, uint64_t rel_ns,
+                      struct acd_exact_snapshot *out);
+};
+int acd_kext_set_exact_backend(struct acd_kext *k, const struct acd_exact_backend *backend);
+
