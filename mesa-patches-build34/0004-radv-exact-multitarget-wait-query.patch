+/* A finite snapshot of sequence numbers, never pointers into mutable syncobjs.
+ * A callback can reset/destroy/reuse handles, grow objs or attach new points.
+ * Recheck current state under mtx after each callback; new submissions belong
+ * to the next sweep. No completed-sequence history is retained. */
+struct acd_targets {
+   uint64_t *seqs;
+   size_t count, capacity;
+};
+
+static int
+add_target(struct acd_targets *targets, uint64_t seq)
+{
+   if (targets->count == targets->capacity) {
+      size_t cap = targets->capacity ? targets->capacity * 2 : 16;
+      if (cap < targets->capacity || cap > SIZE_MAX / sizeof(*targets->seqs))
+         return -ENOMEM;
+      uint64_t *seqs = realloc(targets->seqs, cap * sizeof(*seqs));
+      if (!seqs)
+         return -ENOMEM;
+      targets->seqs = seqs;
+      targets->capacity = cap;
+   }
+   targets->seqs[targets->count++] = seq;
+   return 0;
+}
+
+static int
+compare_seq(const void *a, const void *b)
+{
+   uint64_t x = *(const uint64_t *)a, y = *(const uint64_t *)b;
+   return (x > y) - (x < y);
+}
+
+/* Called with mtx held. Query collects all outstanding timeline candidates;
+ * wait collects all candidates able to satisfy each requested payload. A
+ * higher timeline point can satisfy a lower point despite an earlier gap. */
+static int
+snapshot_targets(struct acd_sync *s, const uint32_t *handles, const uint64_t *points,
+                 unsigned n, bool query, struct acd_targets *targets)
+{
+   for (unsigned i = 0; i < n; i++) {
+      struct acd_syncobj *o = lookup(s, handles[i]);
+      if (!o)
+         return -EINVAL;
+      fold(s, o);
+      uint64_t point = points ? points[i] : 0;
+      if (!query && point == 0) {
+         if (!o->bin_cpu && o->bin_seq) {
+            int r = add_target(targets, o->bin_seq);
+            if (r)
