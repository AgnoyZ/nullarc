diff --git a/src/nmplugin/NVMTLEventSync.m b/src/nmplugin/NVMTLEventSync.m
--- a/src/nmplugin/NVMTLEventSync.m
+++ b/src/nmplugin/NVMTLEventSync.m
@@ -389,4 +389,14 @@
     // Another process may read an IOSurface once its writer is scheduled, and nothing orders its queue after ours.
-    static int after = -1; if (after < 0) { const char *e = getenv("NVMTL_SCHEDULE_AFTER_SURFACE_WRITES"); after = e && e[0] == '1'; }
+    static int after = -1;
+    if (after < 0) {
+        const char *e = getenv("NVMTL_SCHEDULE_AFTER_SURFACE_WRITES");
+        if (e && e[0] == '1' && !e[1]) after = 1;
+        else if (e && e[0] == '0' && !e[1]) after = 0;
+        else after = nvmtl_surface_commit_wait_on() ? 1 : 0;
+    }
     NVMTLTexture *drawable = _present ? (_present->_parent ?: _present) : nil;
-    for (NVMTLTexture *s in part->surfaces) if (after && s != drawable) _scheduleAfterPublish = YES;
+    if (after) {
+        for (NVMTLTexture *s in part->surfaces) {
+            if (s->_surf && (s != drawable || nvmtl_surface_commit_wait_on())) { _scheduleAfterPublish = YES; break; }
+        }
+    }
diff --git a/src/nmplugin/NVMTLObjects.m b/src/nmplugin/NVMTLObjects.m
--- a/src/nmplugin/NVMTLObjects.m
+++ b/src/nmplugin/NVMTLObjects.m
@@ -1347 +1347,12 @@
-    if (!r->_surf || r->_hostOn) return YES;   // host-backed: the GPU wrote the surface's own pages
+    if (!r->_surf) return YES;
+    if (r->_hostOn) {   // host-backed: the GPU wrote the surface's own pages; advance seed so cross-process readers notice
+        if (!nvmtl_noseed()) {
+            uint32_t seed = 0;
+            if (IOSurfaceLock(r->_surf, kIOSurfaceLockAvoidSync, NULL) == kIOReturnSuccess) {
+                if (IOSurfaceUnlock(r->_surf, kIOSurfaceLockAvoidSync, &seed) == kIOReturnSuccess)
+                    r->_surfSeed = seed;
+            }
+        }
+        r->_surfSynced = YES;
+        return YES;
+    }
